{{!-- Pratinjau tulisan di kanan daftar (layar lebar). Berganti saat baris disorot. --}}
<div class="peek{{#if @first}} is-on{{/if}}" data-peek="{{slug}}">
    {{#if feature_image}}
        <img class="peek-img" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" width="720" height="540" loading="lazy">
    {{/if}}
    {{#if excerpt}}<p class="peek-text">{{excerpt words="34"}}</p>{{/if}}
    <p class="peek-meta">{{primary_author.name}} · {{reading_time minute="1 menit baca" minutes="% menit baca"}}</p>
</div>
