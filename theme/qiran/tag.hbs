{{!< default}}

<section class="archive archive-top has-peek" aria-labelledby="archive-title">
    <div class="archive-col">
        {{#tag}}
        <h1 class="archive-title js-lines js-fit-title" id="archive-title">Tulisan bertopik {{name}}</h1>
        <p class="lead-soft">{{#if description}}{{description}}{{else}}Semua tulisan di {{@site.title}} dengan topik {{name}}.{{/if}} {{plural ../pagination.total empty="" singular="Ada % tulisan." plural="Ada % tulisan."}}</p>
        {{/tag}}
        <ol class="rows js-rows">
            {{#foreach posts}}{{> row}}{{/foreach}}
        </ol>
        {{> pagination}}
    </div>
    <aside class="peeks" aria-label="Pratinjau tulisan">
        {{#foreach posts}}{{> peek}}{{/foreach}}
    </aside>
</section>
