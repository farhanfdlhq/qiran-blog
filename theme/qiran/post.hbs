{{!< default}}

{{#post}}
<article class="article {{post_class}}">
    <header class="article-head">
        <h1 class="article-title js-lines js-fit-title">{{title}}</h1>
        <div class="article-meta reveal">
            {{#primary_author}}<a class="article-author" href="{{url}}">{{name}}</a>{{/primary_author}}
            <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time></span>
            <span>{{reading_time minute="1 menit baca" minutes="% menit baca"}}</span>
            {{#primary_tag}}<a class="article-tag" href="{{url}}">{{name}}</a>{{/primary_tag}}
        </div>
        {{#if custom_excerpt}}<p class="article-lede reveal">{{custom_excerpt}}</p>{{/if}}
    </header>

    {{#if feature_image}}
    <figure class="article-figure">
        <img
            srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 1400w, {{img_url feature_image size="xxl"}} 2000w"
            sizes="(min-width: 1100px) 1100px, 100vw"
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            width="2000" height="1250" fetchpriority="high">
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="gh-content article-body">
        {{content}}
    </div>

    {{#if tags}}
    <footer class="article-end reveal">
        <p class="article-tags">Topik: {{#foreach tags}}<a class="textlink" href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</p>
    </footer>
    {{/if}}

    {{#if comments}}
    <section class="article-comments" aria-label="Komentar">
        {{comments title="Komentar" count=true}}
    </section>
    {{/if}}
</article>

{{#get "posts" filter="id:-{{id}}" limit="5" as |more|}}
    {{#if more}}
    <section class="archive archive-more" aria-labelledby="more-title">
        <div class="archive-col">
            <h2 class="archive-title reveal" id="more-title">Tulisan lainnya</h2>
            <ol class="rows">
                {{#foreach more}}{{> row}}{{/foreach}}
            </ol>
        </div>
    </section>
    {{/if}}
{{/get}}
{{/post}}
