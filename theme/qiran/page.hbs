{{!< default}}

{{#post}}
<article class="article {{post_class}}">
    {{#match @page.show_title_and_feature_image}}
    <header class="article-head">
        <h1 class="article-title js-lines js-fit-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-lede reveal">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if feature_image}}
    <figure class="article-figure">
        <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" width="2000" height="1250" fetchpriority="high">
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}
    {{/match}}

    <div class="gh-content article-body">
        {{content}}
    </div>
</article>
{{/post}}
