# Salin menjadi .env.production (server) atau .env.local (komputer sendiri).

# Alamat situs, tanpa garis miring di akhir
SITE_URL=https://qiran.my.id

# Folder data: database SQLite dan gambar yang diunggah. Harus di luar folder kode.
DATA_DIR=/opt/qiran-blog/data/web

# Port aplikasi (aaPanel / Nginx meneruskan ke sini)
PORT=3100
