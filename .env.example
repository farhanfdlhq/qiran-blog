# Salin menjadi .env lalu isi. File .env TIDAK ikut masuk git.
#   cp .env.example .env

DOMAIN=qiran.my.id
GHOST_PORT=2368
GHOST_VERSION=6-alpine

# Buat password acak, misalnya dengan: openssl rand -hex 24
DATABASE_PASSWORD=
DATABASE_ROOT_PASSWORD=

# --- Email (wajib agar bisa login dari perangkat baru & reset password) ---
# Contoh pakai Gmail: aktifkan 2FA di akun Google, lalu buat "App password"
# di https://myaccount.google.com/apppasswords
MAIL_FROM="Blog Qiran <alamat@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alamat@gmail.com
SMTP_PASSWORD=
